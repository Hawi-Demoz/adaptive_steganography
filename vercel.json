{
  "framework": "vite",
  "installCommand": "npm ci --prefix web/frontend",
  "buildCommand": "npm run build --prefix web/frontend",
  "outputDirectory": "web/frontend/dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://adaptive-steganography-00.onrender.com/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}